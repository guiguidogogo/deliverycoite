generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ATTENDANT
}

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  FINISHED
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  MERCADO_PAGO
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderSource {
  DELIVERY
  TABLE
  TABLE_QR
  COUNTER
  WAITER
}

enum TableSessionStatus {
  PENDING_CONFIRMATION
  OPEN
  CLOSING_REQUESTED
  CLOSED
  CANCELLED
}

enum TableStatus {
  FREE
  OCCUPIED
  WAITING_PAYMENT
  RESERVED
  CLEANING
}

enum CashEntryType {
  OPENING
  WITHDRAWAL
  EXPENSE
  MANUAL_INCOME
  CLOSING
}

enum DeliveryRouteStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum BusinessType {
  FOOD
  EVENTS
  BARBERSHOP
  BEAUTY_SALON
  PHARMACY
  MARKET
  CLINIC
  SERVICES
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum TicketOrderStatus {
  RESERVED
  PAID
  CANCELLED
}

enum TicketPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  RESERVED
  PAID
  CANCELLED
  USED
}

enum TicketAudience {
  GENERAL
  MEN
  WOMEN
  COUPLE
  STUDENT
  VIP
  OTHER
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELED
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String?
  passwordHash   String
  role           UserRole        @default(ATTENDANT)
  active         Boolean         @default(true)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staffRoleId    String?
  staffRole      StaffRole?      @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  waiterOrders   Order[]         @relation("WaiterOrders")
  openedTableSessions TableSession[] @relation("OpenedTableSessions")
  closedTableSessions TableSession[] @relation("ClosedTableSessions")
  passwordResets PasswordReset[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId])
}

model UploadedImage {
  id           String   @id @default(cuid())
  data         Bytes
  mimeType     String
  originalName String?
  createdAt    DateTime @default(now())
}

model Company {
  id                     String                @id @default(cuid())
  companyName            String
  tradeName              String
  cnpj                   String?               @unique
  phone                  String?
  whatsapp               String?
  instagram              String?
  email                  String?
  subdomain              String                @unique
  logoUrl                String?
  faviconUrl             String?
  primaryColor           String                @default("#e76f51")
  secondaryColor         String                @default("#7ebc59")
  active                 Boolean               @default(true)
  marketplaceVisible     Boolean               @default(true)
  featured               Boolean               @default(false)
  businessType           BusinessType          @default(FOOD)
  category               String                @default("Lanches")
  city                   String                @default("Conceição do Coité")
  isOpen                 Boolean               @default(true)
  deliveryFee            Decimal               @default(5) @db.Decimal(10, 2)
  deliveryTimeMin        Int                   @default(35)
  rating                 Decimal               @default(5) @db.Decimal(2, 1)
  customDomain           String?               @unique
  address                String?
  plan                   String                @default("basico")
  mercadoPagoPublicKey   String?
  mercadoPagoAccessToken String?
  mercadoPagoEnabled     Boolean               @default(false)
  printerAgentTokenHash  String?
  printerAgentEnabled    Boolean               @default(false)
  printerAgentLastSeenAt DateTime?
  menuiaApiKey           String?
  menuiaStoreId          String?
  printerName            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  users                  User[]
  staffRoles             StaffRole[]
  categories             Category[]
  products               Product[]
  complements            Complement[]
  customers              Customer[]
  companyCustomers       CompanyCustomer[]
  settings               Setting[]
  coupons                Coupon[]
  orders                 Order[]
  tableSessions          TableSession[]
  cashSessions           CashSession[]
  cashEntries            CashEntry[]
  deliveryFeeTiers       DeliveryFeeTier[]
  customerAddresses      CustomerAddress[]
  productComplements     ProductComplement[]
  couponRedemptions      CouponRedemption[]
  orderItems             OrderItem[]
  orderItemComplements   OrderItemComplement[]
  passwordResets         PasswordReset[]
  favorites              Favorite[]
  drivers                Driver[]
  deliveryRoutes         DeliveryRoute[]
  deliveryRouteOrders    DeliveryRouteOrder[]
  driverDeviceTokens     DriverDeviceToken[]
  diningAreas            DiningArea[]
  restaurantTables       RestaurantTable[]
  printerJobs            PrinterJob[]
  auditLogs              AuditLog[]
  payables               AccountPayable[]
  receivables            AccountReceivable[]
  events                 Event[]
  ticketOrders           TicketOrder[]
  services               Service[]
  professionals          Professional[]
  appointments           Appointment[]
}

model Event {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  bannerUrl   String?
  location    String
  eventDate   DateTime
  startTime   String
  endTime     String?
  status      EventStatus  @default(DRAFT)
  ticketTypes TicketType[]
  ticketOrders TicketOrder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId, status, eventDate])
}

model TicketType {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  audience      TicketAudience @default(GENERAL)
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  quantityTotal Int
  quantitySold  Int      @default(0)
  lotName       String?
  saleStart     DateTime?
  saleEnd       DateTime?
  active        Boolean  @default(true)
  tickets       Ticket[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId, active])
}

model TicketOrder {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  customerEmail String?
  total         Decimal             @db.Decimal(10, 2)
  status        TicketOrderStatus   @default(RESERVED)
  paymentMethod PaymentMethod?
  paymentStatus TicketPaymentStatus @default(PENDING)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?
  mercadoPagoStatus       String?
  mercadoPagoStatusDetail String?
  paidAt        DateTime?
  tickets       Ticket[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([companyId, eventId, createdAt])
  @@index([companyId, status, paymentStatus])
  @@index([mercadoPagoPreferenceId])
  @@index([mercadoPagoPaymentId])
}

model Ticket {
  id            String       @id @default(cuid())
  ticketOrderId String
  ticketOrder   TicketOrder  @relation(fields: [ticketOrderId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  qrCode        String       @unique
  code          String       @unique
  status        TicketStatus @default(RESERVED)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ticketOrderId])
  @@index([ticketTypeId])
  @@index([status])
}

model Service {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  durationMin    Int
  price          Decimal         @db.Decimal(10, 2)
  active         Boolean         @default(true)
  popular        Boolean         @default(false)
  appointments   Appointment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyId, active])
}

model Professional {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  specialty      String
  avatarUrl      String?
  bio            String?
  rating         Decimal         @default(5) @db.Decimal(2, 1)
  active         Boolean         @default(true)
  appointments   Appointment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyId, active])
}

model Appointment {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professionalId  String?
  professional    Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  customerEmail   String?
  appointmentDate DateTime
  appointmentTime String
  notes           String?
  status          AppointmentStatus @default(REQUESTED)
  total           Decimal           @db.Decimal(10, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId, status, appointmentDate])
  @@index([companyId, serviceId])
}

model StaffRole {
  id          String   @id @default(cuid())
  name        String
  permissions String[] @default([])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Category {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Decimal             @db.Decimal(10, 2)
  promoPrice  Decimal?            @db.Decimal(10, 2)
  imageUrl    String?
  available   Boolean             @default(true)
  active      Boolean             @default(true)
  trackStock  Boolean             @default(false)
  stockQuantity Decimal           @default(0) @db.Decimal(10, 3)
  lowStockAlert Decimal?          @db.Decimal(10, 3)
  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  favorites   Favorite[]
  complements ProductComplement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([categoryId])
  @@index([companyId])
}

model Complement {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Decimal               @default(0) @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean               @default(true)
  trackStock  Boolean               @default(false)
  stockQuantity Decimal             @default(0) @db.Decimal(10, 3)
  lowStockAlert Decimal?            @db.Decimal(10, 3)
  products    ProductComplement[]
  orderItems  OrderItemComplement[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([companyId])
}

model ProductComplement {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  complementId String
  complement   Complement @relation(fields: [complementId], references: [id], onDelete: Cascade)
  required     Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, complementId])
  @@index([companyId])
  @@index([productId, sortOrder])
  @@index([complementId])
}

model Customer {
  id                String             @id @default(cuid())
  globalCustomerId  String?
  globalCustomer    GlobalCustomer?    @relation(fields: [globalCustomerId], references: [id], onDelete: SetNull)
  companyCustomerId String?
  companyCustomer   CompanyCustomer?   @relation(fields: [companyCustomerId], references: [id], onDelete: SetNull)
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  address           String
  number            String
  district          String
  complement        String?
  email             String?
  passwordHash      String?
  addresses         CustomerAddress[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  passwordResets    PasswordReset[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?

  @@index([globalCustomerId])
  @@index([companyCustomerId])
  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, deletedAt])
}

model GlobalCustomer {
  id               String            @id @default(cuid())
  name             String
  email            String?           @unique
  phone            String            @unique
  whatsapp         String?
  passwordHash     String?
  lastAccessAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  companyCustomers CompanyCustomer[]
  customers        Customer[]

  @@index([phone])
  @@index([email])
}

model CompanyCustomer {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  globalCustomerId    String
  globalCustomer      GlobalCustomer    @relation(fields: [globalCustomerId], references: [id], onDelete: Cascade)
  firstPurchaseAt     DateTime?
  lastPurchaseAt      DateTime?
  ordersCount         Int               @default(0)
  totalSpent          Decimal           @default(0) @db.Decimal(12, 2)
  averageTicket       Decimal           @default(0) @db.Decimal(12, 2)
  notes               String?
  loyaltyPoints       Int               @default(0)
  active              Boolean           @default(true)
  preferences         Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  customers           Customer[]

  @@unique([companyId, globalCustomerId])
  @@index([companyId, active])
  @@index([companyId, lastPurchaseAt])
  @@index([globalCustomerId])
}

model PasswordReset {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([companyId])
}

model CashSession {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedBy      String
  operatorName  String?
  openingIp     String?
  openingDevice String?
  openingAmount Decimal     @db.Decimal(10, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  closingAmount Decimal?    @db.Decimal(10, 2)
  expectedAmount Decimal?   @db.Decimal(10, 2)
  difference     Decimal?   @db.Decimal(10, 2)
  closingNotes   String?
  closedBy       String?
  closingIp      String?
  closingDevice  String?
  reopenedAt     DateTime?
  reopenedBy     String?
  reopenReason   String?
  locked         Boolean    @default(false)
  deletedAt      DateTime?
  notes         String?
  entries       CashEntry[]

  @@index([openedAt])
  @@index([closedAt])
  @@index([companyId])
  @@index([companyId, openedBy, closedAt])
}

model CashEntry {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionId     String
  session       CashSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          CashEntryType
  category      String?
  direction     String         @default("IN")
  amount        Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  paymentDetail String?
  orderId       String?
  operatorId    String?
  operatorName  String?
  reason        String?
  description   String?
  deletedAt     DateTime?
  deletedBy     String?
  deletionReason String?
  createdAt     DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@index([companyId])
  @@index([companyId, createdAt, direction])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  device      String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@index([companyId, userId])
}

model AccountPayable {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  dueDate     DateTime
  status      String   @default("PENDING")
  paidAt      DateTime?
  notes       String?
  createdBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, dueDate, status])
}

model AccountReceivable {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerName String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  dueDate     DateTime
  status      String   @default("OPEN")
  receivedAt  DateTime?
  notes       String?
  createdBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, dueDate, status])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String // Casa, Trabalho, etc
  address    String
  number     String
  district   String
  complement String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([companyId])
}

model Coupon {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  type               String
  value              Decimal            @db.Decimal(10, 2)
  minOrder           Decimal?           @db.Decimal(10, 2)
  maxUses            Int?
  maxUsesPerCustomer Int?
  maxUsesPerDay      Int?
  active             Boolean            @default(true)
  expiresAt          DateTime?
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model Order {
  id                 String            @id @default(cuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderNumber        Int               @unique @default(autoincrement())
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  status             OrderStatus       @default(RECEIVED)
  source             OrderSource       @default(DELIVERY)
  paymentMethod      PaymentMethod
  fulfillmentType    FulfillmentType   @default(DELIVERY)
  tableId            String?
  table              RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSessionId     String?
  tableSession       TableSession?     @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  waiterId           String?
  waiter             User?             @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: SetNull)
  changeFor          Decimal?          @db.Decimal(10, 2)
  subtotal           Decimal           @db.Decimal(10, 2)
  deliveryFee        Decimal           @db.Decimal(10, 2)
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  deliveryDistanceKm Float?
  discount           Decimal           @default(0) @db.Decimal(10, 2)
  total              Decimal           @db.Decimal(10, 2)
  couponCode         String?
  customerNotes      String?
  paidAt             DateTime?
  paidMethodDetail   String?
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?
  mercadoPagoStatus       String?
  mercadoPagoStatusDetail String?
  notes              String?
  whatsappLink       String?
  printerQueuedAt    DateTime?
  printerPrintedAt   DateTime?
  printerPrintCount  Int               @default(0)
  printerLastError   String?
  viewedByStaff      Boolean           @default(false)
  sentToDelivery     Boolean           @default(false)
  deliverySentAt     DateTime?
  deletedAt           DateTime?
  deletedBy           String?
  deletionReason      String?
  deliveryRouteOrders DeliveryRouteOrder[]
  items              OrderItem[]
  couponRedemption   CouponRedemption?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([companyId])
  @@index([companyId, source])
  @@index([companyId, tableId])
  @@index([companyId, tableSessionId])
  @@index([companyId, deletedAt])
  @@index([mercadoPagoPreferenceId])
  @@index([mercadoPagoPaymentId])
  @@index([companyId, printerPrintedAt])
}

model DiningArea {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean           @default(true)
  tables    RestaurantTable[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model RestaurantTable {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  areaId       String?
  area         DiningArea?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  number       Int
  name         String?
  seats        Int          @default(4)
  status       TableStatus  @default(FREE)
  qrCodeToken  String       @unique
  active       Boolean      @default(true)
  openedAt     DateTime?
  closedAt     DateTime?
  orders       Order[]
  sessions     TableSession[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, areaId])
}

model TableSession {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tableId        String
  table          RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status         TableSessionStatus @default(OPEN)
  token          String             @unique
  shortCode      String
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  openedByUserId String?
  openedByUser   User?              @relation("OpenedTableSessions", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedByUserId String?
  closedByUser   User?              @relation("ClosedTableSessions", fields: [closedByUserId], references: [id], onDelete: SetNull)
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  expiresAt      DateTime?
  lastActivityAt DateTime           @default(now())
  waiterCalledAt DateTime?
  billRequestedAt DateTime?
  total          Decimal            @default(0) @db.Decimal(10, 2)
  orders         Order[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId, status])
  @@index([companyId, tableId, openedAt])
  @@index([token])
}

model PrinterJob {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String
  title          String
  referenceId    String?
  referenceLabel String?
  receipt        String
  copies         Int       @default(1)
  queuedAt       DateTime?
  printedAt      DateTime?
  printCount     Int       @default(0)
  lastError      String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, printedAt, queuedAt])
  @@index([companyId, type, createdAt])
  @@index([referenceId])
}

model Driver {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  whatsapp          String
  vehicle           String
  licensePlate      String?
  passwordHash      String?
  active            Boolean             @default(true)
  available         Boolean             @default(true)
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  deliveryRoutes    DeliveryRoute[]
  deviceTokens      DriverDeviceToken[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([companyId, phone])
  @@index([companyId, active])
}

model DeliveryRoute {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId        String
  driver          Driver               @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status          DeliveryRouteStatus  @default(CREATED)
  googleMapsUrl   String
  whatsappMessage String
  startedAt       DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  offerExpiresAt  DateTime?
  orders          DeliveryRouteOrder[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, status])
  @@index([driverId, createdAt])
  @@index([status, offerExpiresAt])
}

model DriverDeviceToken {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  expoToken  String   @unique
  platform   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, driverId])
}

model DeliveryRouteOrder {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routeId     String
  route       DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sequence    Int
  address     String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())

  @@unique([routeId, orderId])
  @@unique([routeId, sequence])
  @@index([companyId])
  @@index([orderId])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt     DateTime @default(now())

  @@index([couponId, usedAt])
  @@index([customerId, usedAt])
  @@index([companyId])
}

model OrderItem {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product               @relation(fields: [productId], references: [id])
  quantity    Int
  price       Decimal               @db.Decimal(10, 2)
  total       Decimal               @db.Decimal(10, 2)
  complements OrderItemComplement[]

  @@index([companyId])
}

model OrderItemComplement {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  complementId String?
  complement   Complement? @relation(fields: [complementId], references: [id], onDelete: SetNull)
  name         String
  quantity     Int
  price        Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)

  @@index([orderItemId])
  @@index([complementId])
  @@index([companyId])
}

model Setting {
  id                         String            @id @default(cuid())
  companyId                  String
  company                    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName                String            @default("Lanchonete Delivery")
  logoUrl                    String?
  promoBannerImageUrl        String?
  promoBannerTitle           String            @default("PROMO DA NOITE")
  promoBannerText            String            @default("Confira nossos cupons e promocoes")
  whatsappNumber             String
  deliveryPhoneNumber        String?
  deliveryFee                Decimal           @default(5) @db.Decimal(10, 2)
  ordersPaused               Boolean           @default(false)
  ordersPausedReason         String?
  storeLatitude              Float?
  storeLongitude             Float?
  openTime                   String            @default("18:00")
  closeTime                  String            @default("23:59")
  autoMessage                String            @default("Obrigado pelo pedido!")
  pixKey                     String?
  pixQrCodeUrl               String?
  darkModeEnabled            Boolean           @default(true)
  menuiaApiKey               String?
  menuiaStoreId              String?
  menuiaEnabled              Boolean           @default(false)
  whatsappOnReceived         Boolean           @default(true)
  whatsappOnPreparing        Boolean           @default(true)
  whatsappOnOutForDelivery   Boolean           @default(true)
  whatsappOnDelivered        Boolean           @default(true)
  whatsappOnFinished         Boolean           @default(true)
  whatsappOnCanceled         Boolean           @default(true)
  whatsappOnPaymentConfirmed Boolean           @default(true)
  printerEnabled             Boolean           @default(false)
  printerName                String?
  printerPaperWidth          Int               @default(58)
  printerAutoPrint           Boolean           @default(false)
  tableServiceFeeEnabled     Boolean           @default(false)
  tableServiceFeePercent     Decimal           @default(10) @db.Decimal(5, 2)
  updatedAt                  DateTime          @updatedAt
  createdAt                  DateTime          @default(now())
  deliveryFeeTiers           DeliveryFeeTier[]

  @@unique([companyId])
  @@index([companyId])
}

model DeliveryFeeTier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settingId     String
  setting       Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  maxDistanceKm Float
  fee           Decimal  @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([settingId, sortOrder])
  @@index([companyId])
}

model Favorite {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phone     String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([companyId, phone, productId])
  @@index([companyId])
}
