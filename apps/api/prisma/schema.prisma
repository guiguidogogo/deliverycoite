generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ATTENDANT
}

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  FINISHED
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  MERCADO_PAGO
}

enum ClosedOrderPolicy {
  BLOCK_WHEN_CLOSED
  ALLOW_WHEN_CLOSED
  SCHEDULE_ONLY_WHEN_CLOSED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderSource {
  DELIVERY
  TABLE
  TABLE_QR
  COUNTER
  WAITER
}

enum TableSessionStatus {
  PENDING_CONFIRMATION
  OPEN
  CLOSING_REQUESTED
  CLOSED
  CANCELLED
}

enum TableStatus {
  FREE
  OCCUPIED
  WAITING_PAYMENT
  RESERVED
  CLEANING
}

enum CashEntryType {
  OPENING
  WITHDRAWAL
  EXPENSE
  MANUAL_INCOME
  CLOSING
}

enum DeliveryRouteStatus {
  CREATED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum BusinessType {
  FOOD
  EVENTS
  BARBERSHOP
  BEAUTY_SALON
  PHARMACY
  MARKET
  CLINIC
  SERVICES
  RAFFLE
  IPTV
}

enum RaffleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
  FINISHED
}

enum RaffleNumberStatus {
  AVAILABLE
  RESERVED
  PENDING_PAYMENT
  PAID
  BLOCKED
  CANCELLED
}

enum RaffleOrderStatus {
  RESERVED
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum RafflePaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum RaffleMediaType {
  IMAGE
  VIDEO
  THUMBNAIL
  SHARE_BANNER
}

enum RaffleDrawMode {
  MANUAL
  AUTOMATIC_CAIXA
}

enum RaffleDrawStatus {
  MANUAL
  SCHEDULED
  WAITING_CONTEST
  WAITING_RESULT
  PROCESSING
  CONFIRMED
  NO_VALID_PARTICIPANT
  ERROR
}

enum AppProduct {
  GUIGUI_PLAYER
}

enum AppPairingStatus {
  PENDING
  PAIRED
  ACKNOWLEDGED
  EXPIRED
}

enum AppSubscriberPlan {
  TRIAL_7_DAYS
  DAYS_30
  DAYS_60
  DAYS_90
  MONTHS_6
  YEAR_1
  LIFETIME
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String
  phone          String?
  passwordHash   String
  role           UserRole        @default(ATTENDANT)
  active         Boolean         @default(true)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staffRoleId    String?
  staffRole      StaffRole?      @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  waiterOrders   Order[]         @relation("WaiterOrders")
  openedTableSessions TableSession[] @relation("OpenedTableSessions")
  closedTableSessions TableSession[] @relation("ClosedTableSessions")
  passwordResets PasswordReset[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId])
}

model UploadedImage {
  id           String   @id @default(cuid())
  data         Bytes
  mimeType     String
  originalName String?
  createdAt    DateTime @default(now())
}

model Company {
  id                     String                @id @default(cuid())
  companyName            String
  tradeName              String
  cnpj                   String?               @unique
  phone                  String?
  whatsapp               String?
  instagram              String?
  email                  String?
  subdomain              String                @unique
  logoUrl                String?
  faviconUrl             String?
  primaryColor           String                @default("#e76f51")
  secondaryColor         String                @default("#7ebc59")
  active                 Boolean               @default(true)
  marketplaceVisible     Boolean               @default(true)
  featured               Boolean               @default(false)
  businessType           BusinessType          @default(FOOD)
  category               String                @default("Lanches")
  city                   String                @default("Conceição do Coité")
  isOpen                 Boolean               @default(true)
  deliveryFee            Decimal               @default(5) @db.Decimal(10, 2)
  deliveryTimeMin        Int                   @default(35)
  rating                 Decimal               @default(5) @db.Decimal(2, 1)
  customDomain           String?               @unique
  address                String?
  plan                   String                @default("basico")
  mercadoPagoPublicKey   String?
  mercadoPagoAccessToken String?
  mercadoPagoEnabled     Boolean               @default(false)
  printerAgentTokenHash  String?
  printerAgentEnabled    Boolean               @default(false)
  printerAgentLastSeenAt DateTime?
  menuiaApiKey           String?
  menuiaStoreId          String?
  printerName            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  users                  User[]
  staffRoles             StaffRole[]
  categories             Category[]
  products               Product[]
  complements            Complement[]
  customers              Customer[]
  companyCustomers       CompanyCustomer[]
  settings               Setting[]
  coupons                Coupon[]
  orders                 Order[]
  tableSessions          TableSession[]
  cashSessions           CashSession[]
  cashEntries            CashEntry[]
  deliveryFeeTiers       DeliveryFeeTier[]
  customerAddresses      CustomerAddress[]
  productComplements     ProductComplement[]
  couponRedemptions      CouponRedemption[]
  orderItems             OrderItem[]
  orderItemComplements   OrderItemComplement[]
  passwordResets         PasswordReset[]
  favorites              Favorite[]
  drivers                Driver[]
  deliveryRoutes         DeliveryRoute[]
  deliveryRouteOrders    DeliveryRouteOrder[]
  driverDeviceTokens     DriverDeviceToken[]
  diningAreas            DiningArea[]
  restaurantTables       RestaurantTable[]
  businessHours          CompanyBusinessHour[]
  printerJobs            PrinterJob[]
  auditLogs              AuditLog[]
  payables               AccountPayable[]
  receivables            AccountReceivable[]
  raffles                Raffle[]
  raffleParticipants     RaffleParticipant[]
  raffleNumbers          RaffleNumber[]
  raffleOrders           RaffleOrder[]
  rafflePayments         RafflePayment[]
  raffleAuditLogs        RaffleAuditLog[]
  appSubscriptions       AppSubscription[]
}

model CompanyBusinessHour {
  id        String                      @id @default(cuid())
  companyId String
  company   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  isOpen    Boolean                     @default(false)
  periods   CompanyBusinessHourPeriod[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@unique([companyId, dayOfWeek])
  @@index([companyId])
}

model CompanyBusinessHourPeriod {
  id             String              @id @default(cuid())
  businessHourId String
  businessHour   CompanyBusinessHour @relation(fields: [businessHourId], references: [id], onDelete: Cascade)
  openingTime    String
  closingTime    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([businessHourId])
}

model AppSubscription {
  id                 String          @id @default(cuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            AppProduct      @default(GUIGUI_PLAYER)
  active             Boolean         @default(true)
  startsAt           DateTime        @default(now())
  expiresAt          DateTime?
  maxDevices         Int             @default(1)
  activationCodeHash String          @unique
  credentials        AppIptvCredentials?
  devices            AppDevice[]
  pairings           AppPairing[]
  subscribers        AppSubscriber[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([companyId, active])
  @@index([product, active, expiresAt])
}

model AppSubscriber {
  id                      String            @id @default(cuid())
  subscriptionId          String
  subscription            AppSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  name                    String
  phone                   String?
  active                  Boolean           @default(true)
  plan                    AppSubscriberPlan @default(TRIAL_7_DAYS)
  startsAt                DateTime          @default(now())
  expiresAt               DateTime?
  maxDevices              Int               @default(1)
  activationCodeHash      String            @unique
  activationCodeEncrypted String
  devices                 AppDevice[]
  pairings                AppPairing[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([subscriptionId, active])
  @@index([subscriptionId, expiresAt])
}

model AppIptvCredentials {
  id                   String          @id @default(cuid())
  subscriptionId       String          @unique
  subscription         AppSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  serverEncrypted      String
  usernameEncrypted    String
  passwordEncrypted    String
  updatedAt            DateTime        @updatedAt
  createdAt            DateTime        @default(now())
}

model AppDevice {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   AppSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriberId   String?
  subscriber     AppSubscriber?  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  deviceIdHash   String
  label          String?
  active         Boolean         @default(true)
  activatedAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([subscriptionId, deviceIdHash])
  @@index([subscriptionId, active])
  @@index([deviceIdHash])
  @@index([subscriberId, active])
}

model AppDeviceTrial {
  id           String       @id @default(cuid())
  deviceIdHash String       @unique
  startsAt     DateTime     @default(now())
  expiresAt    DateTime
  lastSeenAt   DateTime     @default(now())
  pairings     AppPairing[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([expiresAt])
}

model AppPairing {
  id             String            @id @default(cuid())
  code           String            @unique
  deviceIdHash   String
  status         AppPairingStatus  @default(PENDING)
  subscriptionId String?
  subscription   AppSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriberId   String?
  subscriber     AppSubscriber?    @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  trialId        String?
  trial          AppDeviceTrial?    @relation(fields: [trialId], references: [id], onDelete: SetNull)
  serverEncrypted   String?
  usernameEncrypted String?
  passwordEncrypted String?
  expiresAt      DateTime
  pairedAt       DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([deviceIdHash, status])
  @@index([subscriptionId, status])
  @@index([subscriberId, status])
  @@index([trialId, status])
  @@index([expiresAt])
}

model StaffRole {
  id          String   @id @default(cuid())
  name        String
  permissions String[] @default([])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Category {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
}

model Product {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Decimal             @db.Decimal(10, 2)
  promoPrice  Decimal?            @db.Decimal(10, 2)
  imageUrl    String?
  available   Boolean             @default(true)
  active      Boolean             @default(true)
  trackStock  Boolean             @default(false)
  stockQuantity Decimal           @default(0) @db.Decimal(10, 3)
  lowStockAlert Decimal?          @db.Decimal(10, 3)
  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  favorites   Favorite[]
  complements ProductComplement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([categoryId])
  @@index([companyId])
}

model Complement {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Decimal               @default(0) @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean               @default(true)
  trackStock  Boolean               @default(false)
  stockQuantity Decimal             @default(0) @db.Decimal(10, 3)
  lowStockAlert Decimal?            @db.Decimal(10, 3)
  products    ProductComplement[]
  orderItems  OrderItemComplement[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([companyId])
}

model ProductComplement {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  complementId String
  complement   Complement @relation(fields: [complementId], references: [id], onDelete: Cascade)
  required     Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, complementId])
  @@index([companyId])
  @@index([productId, sortOrder])
  @@index([complementId])
}

model Customer {
  id                String             @id @default(cuid())
  globalCustomerId  String?
  globalCustomer    GlobalCustomer?    @relation(fields: [globalCustomerId], references: [id], onDelete: SetNull)
  companyCustomerId String?
  companyCustomer   CompanyCustomer?   @relation(fields: [companyCustomerId], references: [id], onDelete: SetNull)
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  address           String
  number            String
  district          String
  complement        String?
  email             String?
  passwordHash      String?
  addresses         CustomerAddress[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  passwordResets    PasswordReset[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  deletionReason    String?

  @@index([globalCustomerId])
  @@index([companyCustomerId])
  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, deletedAt])
}

model GlobalCustomer {
  id               String            @id @default(cuid())
  name             String
  email            String?           @unique
  phone            String            @unique
  whatsapp         String?
  passwordHash     String?
  lastAccessAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  companyCustomers CompanyCustomer[]
  customers        Customer[]

  @@index([phone])
  @@index([email])
}

model CompanyCustomer {
  id                  String            @id @default(cuid())
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  globalCustomerId    String
  globalCustomer      GlobalCustomer    @relation(fields: [globalCustomerId], references: [id], onDelete: Cascade)
  firstPurchaseAt     DateTime?
  lastPurchaseAt      DateTime?
  ordersCount         Int               @default(0)
  totalSpent          Decimal           @default(0) @db.Decimal(12, 2)
  averageTicket       Decimal           @default(0) @db.Decimal(12, 2)
  notes               String?
  loyaltyPoints       Int               @default(0)
  active              Boolean           @default(true)
  preferences         Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  customers           Customer[]

  @@unique([companyId, globalCustomerId])
  @@index([companyId, active])
  @@index([companyId, lastPurchaseAt])
  @@index([globalCustomerId])
}

model PasswordReset {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([companyId])
}

model CashSession {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedBy      String
  operatorName  String?
  openingIp     String?
  openingDevice String?
  openingAmount Decimal     @db.Decimal(10, 2)
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  closingAmount Decimal?    @db.Decimal(10, 2)
  expectedAmount Decimal?   @db.Decimal(10, 2)
  difference     Decimal?   @db.Decimal(10, 2)
  closingNotes   String?
  closedBy       String?
  closingIp      String?
  closingDevice  String?
  reopenedAt     DateTime?
  reopenedBy     String?
  reopenReason   String?
  locked         Boolean    @default(false)
  deletedAt      DateTime?
  notes         String?
  entries       CashEntry[]

  @@index([openedAt])
  @@index([closedAt])
  @@index([companyId])
  @@index([companyId, openedBy, closedAt])
}

model CashEntry {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionId     String
  session       CashSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          CashEntryType
  category      String?
  direction     String         @default("IN")
  amount        Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  paymentDetail String?
  orderId       String?
  operatorId    String?
  operatorName  String?
  reason        String?
  description   String?
  deletedAt     DateTime?
  deletedBy     String?
  deletionReason String?
  createdAt     DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@index([companyId])
  @@index([companyId, createdAt, direction])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  device      String?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@index([companyId, userId])
}

model AccountPayable {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description String
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  dueDate     DateTime
  status      String   @default("PENDING")
  paidAt      DateTime?
  notes       String?
  createdBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, dueDate, status])
}

model AccountReceivable {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerName String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  dueDate     DateTime
  status      String   @default("OPEN")
  receivedAt  DateTime?
  notes       String?
  createdBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, dueDate, status])
}

model Raffle {
  id                 String              @id @default(cuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug               String
  title              String
  description        String?
  regulation         String?
  prize              String?
  status             RaffleStatus        @default(DRAFT)
  startsAt           DateTime?
  endsAt             DateTime?
  numberStart        Int                 @default(0)
  numberEnd          Int
  numberDigits       Int                 @default(2)
  totalNumbers       Int
  pricePerNumber     Decimal             @db.Decimal(10, 2)
  minimumQuantity    Int                 @default(1)
  maximumQuantity    Int                 @default(10)
  reservationMinutes Int                 @default(15)
  participantLimit   Int?
  featuredImageUrl   String?
  videoUrl           String?
  publishedAt        DateTime?
  finishedAt         DateTime?
  drawMode           RaffleDrawMode      @default(MANUAL)
  drawLotteryModality String?
  drawContestNumber  String?
  drawScheduledAt    DateTime?
  drawStatus         RaffleDrawStatus    @default(MANUAL)
  drawLastAttemptAt  DateTime?
  drawAttemptCount   Int                 @default(0)
  drawLastError      String?
  drawBaseNumber     String?
  drawDigits         Int?
  drawWinningNumber  String?
  drawOfficialDate   DateTime?
  drawConfirmedAt    DateTime?
  drawRawResponse    Json?
  drawWinnerParticipantId String?
  drawWinnerOrderId  String?
  drawWinnerNumberId String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  numbers            RaffleNumber[]
  participants       RaffleParticipant[] @relation("RaffleParticipants")
  orders             RaffleOrder[]
  payments           RafflePayment[]
  media              RaffleMedia[]
  winners            RaffleWinner[]
  auditLogs          RaffleAuditLog[]

  @@unique([companyId, slug])
  @@index([companyId, status])
  @@index([companyId, startsAt, endsAt])
  @@index([companyId, drawMode, drawStatus, drawScheduledAt])
}

model RaffleNumber {
  id                       String              @id @default(cuid())
  companyId                String
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  raffleId                 String
  raffle                   Raffle              @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  number                   Int
  formattedNumber          String
  status                   RaffleNumberStatus  @default(AVAILABLE)
  reservedByParticipantId  String?
  reservedByParticipant    RaffleParticipant?  @relation(fields: [reservedByParticipantId], references: [id], onDelete: SetNull)
  reservedUntil            DateTime?
  orderId                  String?
  order                    RaffleOrder?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paidAt                   DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([raffleId, number])
  @@index([companyId, status])
  @@index([raffleId, status])
  @@index([reservedUntil])
}

model RaffleParticipant {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  raffleId       String?
  raffle         Raffle?         @relation("RaffleParticipants", fields: [raffleId], references: [id], onDelete: SetNull)
  name           String
  birthDate      DateTime?
  phone          String
  email          String?
  cpf            String?
  passwordHash   String?
  acceptedTermsAt DateTime?
  lastAccessAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  numbers        RaffleNumber[]
  orders         RaffleOrder[]

  @@unique([companyId, phone])
  @@index([companyId, email])
  @@index([companyId, cpf])
}

model RaffleOrder {
  id                     String              @id @default(cuid())
  companyId              String
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  raffleId               String
  raffle                 Raffle              @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  participantId          String
  participant            RaffleParticipant   @relation(fields: [participantId], references: [id], onDelete: Restrict)
  status                 RaffleOrderStatus   @default(RESERVED)
  paymentMethod          String?
  paymentStatus          RafflePaymentStatus @default(PENDING)
  subtotal               Decimal             @db.Decimal(10, 2)
  cardFee                Decimal             @default(0) @db.Decimal(10, 2)
  total                  Decimal             @db.Decimal(10, 2)
  mercadoPagoPaymentId   String?
  mercadoPagoPreferenceId String?
  pixQrCode              String?
  pixCopiaCola           String?
  reservationExpiresAt   DateTime?
  paidAt                 DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  numbers                RaffleNumber[]
  items                  RaffleOrderItem[]
  payments               RafflePayment[]

  @@index([companyId, status])
  @@index([raffleId, status])
  @@index([participantId])
  @@index([reservationExpiresAt])
  @@index([mercadoPagoPaymentId])
}

model RaffleOrderItem {
  id              String        @id @default(cuid())
  companyId       String
  orderId         String
  order           RaffleOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raffleNumberId  String
  number          Int
  formattedNumber String
  price           Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())

  @@unique([orderId, raffleNumberId])
  @@index([companyId])
}

model RafflePayment {
  id                   String              @id @default(cuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  raffleId             String
  raffle               Raffle              @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  orderId              String
  order                RaffleOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider             String              @default("MERCADO_PAGO")
  providerPaymentId    String?
  providerEventId      String?
  method               String?
  status               RafflePaymentStatus @default(PENDING)
  amount               Decimal             @db.Decimal(10, 2)
  payload              Json?
  processedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([provider, providerEventId])
  @@index([companyId, status])
  @@index([providerPaymentId])
}

model RaffleMedia {
  id        String          @id @default(cuid())
  companyId String
  raffleId  String
  raffle    Raffle          @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  type      RaffleMediaType @default(IMAGE)
  url       String
  title     String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([companyId, raffleId])
}

model RaffleWinner {
  id                  String             @id @default(cuid())
  companyId           String
  raffleId            String
  raffle              Raffle             @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  raffleNumberId      String?
  number              Int
  formattedNumber     String
  participantName     String?
  participantPhone    String?
  drawMethod          String?
  proofUrl            String?
  notes               String?
  published           Boolean            @default(false)
  drawnAt             DateTime           @default(now())
  createdAt           DateTime           @default(now())

  @@index([companyId, raffleId])
}

model RaffleAuditLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  raffleId    String?
  raffle      Raffle?  @relation(fields: [raffleId], references: [id], onDelete: SetNull)
  userId      String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, raffleId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String // Casa, Trabalho, etc
  address    String
  number     String
  district   String
  complement String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([companyId])
}

model Coupon {
  id                 String             @id @default(cuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  type               String
  value              Decimal            @db.Decimal(10, 2)
  minOrder           Decimal?           @db.Decimal(10, 2)
  maxUses            Int?
  maxUsesPerCustomer Int?
  maxUsesPerDay      Int?
  active             Boolean            @default(true)
  expiresAt          DateTime?
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model Order {
  id                 String            @id @default(cuid())
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderNumber        Int               @unique @default(autoincrement())
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  status             OrderStatus       @default(RECEIVED)
  source             OrderSource       @default(DELIVERY)
  paymentMethod      PaymentMethod
  fulfillmentType    FulfillmentType   @default(DELIVERY)
  tableId            String?
  table              RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSessionId     String?
  tableSession       TableSession?     @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  waiterId           String?
  waiter             User?             @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: SetNull)
  changeFor          Decimal?          @db.Decimal(10, 2)
  subtotal           Decimal           @db.Decimal(10, 2)
  deliveryFee        Decimal           @db.Decimal(10, 2)
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  deliveryDistanceKm Float?
  discount           Decimal           @default(0) @db.Decimal(10, 2)
  total              Decimal           @db.Decimal(10, 2)
  couponCode         String?
  customerNotes      String?
  paidAt             DateTime?
  paidMethodDetail   String?
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?
  mercadoPagoStatus       String?
  mercadoPagoStatusDetail String?
  scheduledFor        DateTime?
  notes              String?
  whatsappLink       String?
  printerQueuedAt    DateTime?
  printerPrintedAt   DateTime?
  printerPrintCount  Int               @default(0)
  printerLastError   String?
  viewedByStaff      Boolean           @default(false)
  sentToDelivery     Boolean           @default(false)
  deliverySentAt     DateTime?
  deletedAt           DateTime?
  deletedBy           String?
  deletionReason      String?
  deliveryRouteOrders DeliveryRouteOrder[]
  items              OrderItem[]
  couponRedemption   CouponRedemption?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([companyId])
  @@index([companyId, source])
  @@index([companyId, tableId])
  @@index([companyId, tableSessionId])
  @@index([companyId, deletedAt])
  @@index([mercadoPagoPreferenceId])
  @@index([mercadoPagoPaymentId])
  @@index([companyId, printerPrintedAt])
}

model DiningArea {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean           @default(true)
  tables    RestaurantTable[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model RestaurantTable {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  areaId       String?
  area         DiningArea?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  number       Int
  name         String?
  seats        Int          @default(4)
  status       TableStatus  @default(FREE)
  qrCodeToken  String       @unique
  active       Boolean      @default(true)
  openedAt     DateTime?
  closedAt     DateTime?
  orders       Order[]
  sessions     TableSession[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, areaId])
}

model TableSession {
  id             String             @id @default(cuid())
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tableId        String
  table          RestaurantTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status         TableSessionStatus @default(OPEN)
  token          String             @unique
  shortCode      String
  customerName   String?
  customerPhone  String?
  customerEmail  String?
  openedByUserId String?
  openedByUser   User?              @relation("OpenedTableSessions", fields: [openedByUserId], references: [id], onDelete: SetNull)
  closedByUserId String?
  closedByUser   User?              @relation("ClosedTableSessions", fields: [closedByUserId], references: [id], onDelete: SetNull)
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  expiresAt      DateTime?
  lastActivityAt DateTime           @default(now())
  waiterCalledAt DateTime?
  billRequestedAt DateTime?
  total          Decimal            @default(0) @db.Decimal(10, 2)
  orders         Order[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId, status])
  @@index([companyId, tableId, openedAt])
  @@index([token])
}

model PrinterJob {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           String
  title          String
  referenceId    String?
  referenceLabel String?
  receipt        String
  copies         Int       @default(1)
  queuedAt       DateTime?
  printedAt      DateTime?
  printCount     Int       @default(0)
  lastError      String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, printedAt, queuedAt])
  @@index([companyId, type, createdAt])
  @@index([referenceId])
}

model Driver {
  id                String              @id @default(cuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  whatsapp          String
  vehicle           String
  licensePlate      String?
  passwordHash      String?
  active            Boolean             @default(true)
  available         Boolean             @default(true)
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  deliveryRoutes    DeliveryRoute[]
  deviceTokens      DriverDeviceToken[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([companyId, phone])
  @@index([companyId, active])
}

model DeliveryRoute {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId        String
  driver          Driver               @relation(fields: [driverId], references: [id], onDelete: Restrict)
  status          DeliveryRouteStatus  @default(CREATED)
  googleMapsUrl   String
  whatsappMessage String
  startedAt       DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  offerExpiresAt  DateTime?
  orders          DeliveryRouteOrder[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, status])
  @@index([driverId, createdAt])
  @@index([status, offerExpiresAt])
}

model DriverDeviceToken {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  expoToken  String   @unique
  platform   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, driverId])
}

model DeliveryRouteOrder {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routeId     String
  route       DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sequence    Int
  address     String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime      @default(now())

  @@unique([routeId, orderId])
  @@unique([routeId, sequence])
  @@index([companyId])
  @@index([orderId])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usedAt     DateTime @default(now())

  @@index([couponId, usedAt])
  @@index([customerId, usedAt])
  @@index([companyId])
}

model OrderItem {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product               @relation(fields: [productId], references: [id])
  quantity    Int
  price       Decimal               @db.Decimal(10, 2)
  total       Decimal               @db.Decimal(10, 2)
  complements OrderItemComplement[]

  @@index([companyId])
}

model OrderItemComplement {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  complementId String?
  complement   Complement? @relation(fields: [complementId], references: [id], onDelete: SetNull)
  name         String
  quantity     Int
  price        Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)

  @@index([orderItemId])
  @@index([complementId])
  @@index([companyId])
}

model Setting {
  id                         String            @id @default(cuid())
  companyId                  String
  company                    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyName                String            @default("Lanchonete Delivery")
  logoUrl                    String?
  promoBannerImageUrl        String?
  promoBannerTitle           String            @default("PROMO DA NOITE")
  promoBannerText            String            @default("Confira nossos cupons e promocoes")
  whatsappNumber             String
  deliveryPhoneNumber        String?
  deliveryFee                Decimal           @default(5) @db.Decimal(10, 2)
  ordersPaused               Boolean           @default(false)
  ordersPausedReason         String?
  storeLatitude              Float?
  storeLongitude             Float?
  openTime                   String            @default("18:00")
  closeTime                  String            @default("23:59")
  timezone                   String            @default("America/Bahia")
  closedOrderPolicy          ClosedOrderPolicy @default(BLOCK_WHEN_CLOSED)
  autoMessage                String            @default("Obrigado pelo pedido!")
  pixKey                     String?
  pixQrCodeUrl               String?
  darkModeEnabled            Boolean           @default(true)
  menuiaApiKey               String?
  menuiaStoreId              String?
  menuiaEnabled              Boolean           @default(false)
  whatsappOnReceived         Boolean           @default(true)
  whatsappOnPreparing        Boolean           @default(true)
  whatsappOnOutForDelivery   Boolean           @default(true)
  whatsappOnDelivered        Boolean           @default(true)
  whatsappOnFinished         Boolean           @default(true)
  whatsappOnCanceled         Boolean           @default(true)
  whatsappOnPaymentConfirmed Boolean           @default(true)
  printerEnabled             Boolean           @default(false)
  printerName                String?
  printerPaperWidth          Int               @default(58)
  printerAutoPrint           Boolean           @default(false)
  tableServiceFeeEnabled     Boolean           @default(false)
  tableServiceFeePercent     Decimal           @default(10) @db.Decimal(5, 2)
  updatedAt                  DateTime          @updatedAt
  createdAt                  DateTime          @default(now())
  deliveryFeeTiers           DeliveryFeeTier[]

  @@unique([companyId])
  @@index([companyId])
}

model DeliveryFeeTier {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settingId     String
  setting       Setting  @relation(fields: [settingId], references: [id], onDelete: Cascade)
  maxDistanceKm Float
  fee           Decimal  @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([settingId, sortOrder])
  @@index([companyId])
}

model Favorite {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phone     String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([companyId, phone, productId])
  @@index([companyId])
}
