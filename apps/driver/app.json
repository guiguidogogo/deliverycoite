{
  "expo": {
    "name": "HubRegional Motoboy",
    "slug": "hubregional-motoboy",
    "version": "1.0.6",
    "orientation": "portrait",
    "scheme": "hubregional-driver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.hubregional.motoboy",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sua localizacao ajuda a empresa a acompanhar a rota de entrega."
      }
    },
    "android": {
      "package": "br.com.hubregional.motoboy",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/ringtone.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que o HubRegional Motoboy use sua localizacao durante as entregas."
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "firebaseConfigured": true,
      "eas": {
        "projectId": "a2847fa4-5012-4414-885c-c7b39090ced6"
      }
    },
    "owner": "higorsantana"
  }
}
